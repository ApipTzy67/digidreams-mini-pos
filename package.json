{
  "name": "digidreams-mini-pos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js",
    "test": "node --import tsx --test src/lib/*.test.ts",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "db:reset": "node node_modules/prisma/build/index.js migrate reset --force",
    "db:studio": "node node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  },
  "prisma": {
    "seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  }
}
